generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  FREELANCER
}

enum ProjectStatus {
  UPCOMING
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum MilestoneStatus {
  PENDING // planned, not funded
  FUNDED // paid into escrow, work in progress
  SUBMITTED // deliverable submitted, awaiting review
  REVISION_REQUESTED // rejected, awaiting resubmission
  APPROVED // approved manually or automatically; terminal
}

enum ApprovalType {
  MANUAL
  AUTO
}

enum SubmissionDecision {
  APPROVED
  REJECTED
}

enum SettlementStatus {
  SCHEDULED // created by the weekly batch, awaiting its payout date
  PROCESSING // transfer in flight
  PAID
  FAILED // transfer failed; retried while attempts remain
  ON_HOLD // no payout account (or the freelancer is soft-deleted)
}

enum MessageKind {
  TEXT // written by a participant
  SYSTEM // contract/milestone event log; no sender (BEHAVIOR.md MG6)
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  FREELANCE
  INTERN
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String?
  name             String
  role             Role
  roleSelected     Boolean   @default(true)
  profileImage     String?
  bio              String?
  companyName      String?
  businessField    String?
  website          String?
  skills           String[]
  activityCategory String?
  experienceYears  Int?
  hourlyRate       Float?
  portfolioUrl     String?
  googleId         String?   @unique
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  clientProjects      Project[]                 @relation("ClientProjects")
  applications        Application[]             @relation("FreelancerApplications")
  clientContracts     Contract[]                @relation("ClientContracts")
  freelancerContracts Contract[]                @relation("FreelancerContracts")
  clientPayments      Payment[]                 @relation("ClientPayments")
  givenReviews        Review[]                  @relation("ReviewerReviews")
  receivedReviews     Review[]                  @relation("RevieweeReviews")
  projectBookmarks    ProjectBookmark[]
  notifications       Notification[]
  settlementItems     SettlementItem[]          @relation("FreelancerSettlementItems")
  settlements         Settlement[]              @relation("FreelancerSettlements")
  payoutAccount       PayoutAccount?
  conversations       ConversationParticipant[]
  sentMessages        Message[]                 @relation("SentMessages")
  portfolioItems      PortfolioItem[]
  careers             Career[]
}

model Project {
  id                   String        @id @default(uuid())
  title                String
  description          String
  category             String
  budget               Float
  recruitmentStartDate DateTime?
  deadline             DateTime
  requiredSkills       String[]
  status               ProjectStatus @default(OPEN)
  clientId             String
  client               User          @relation("ClientProjects", fields: [clientId], references: [id])
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())

  applications    Application[]
  contract        Contract?
  pricingAnalysis PricingAnalysis?
  bookmarks       ProjectBookmark[]
}

model ProjectBookmark {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId, createdAt])
}

model Application {
  id               String            @id @default(uuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  freelancerId     String
  freelancer       User              @relation("FreelancerApplications", fields: [freelancerId], references: [id])
  coverLetter      String
  expectedRate     Float
  expectedDuration String
  status           ApplicationStatus @default(PENDING)
  createdAt        DateTime          @default(now())

  contract Contract?

  @@unique([projectId, freelancerId])
}

model Contract {
  id               String         @id @default(uuid())
  projectId        String         @unique
  project          Project        @relation(fields: [projectId], references: [id])
  applicationId    String         @unique
  application      Application    @relation(fields: [applicationId], references: [id])
  clientId         String
  client           User           @relation("ClientContracts", fields: [clientId], references: [id])
  freelancerId     String
  freelancer       User           @relation("FreelancerContracts", fields: [freelancerId], references: [id])
  amount           Float
  startDate        DateTime
  endDate          DateTime
  clientSigned     Boolean        @default(false)
  freelancerSigned Boolean        @default(false)
  status           ContractStatus @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime       @default(now())

  milestones      Milestone[]
  payments        Payment[]
  settlementItems SettlementItem[]
  reviews         Review[]
  conversation    Conversation?
}

model Milestone {
  id            String          @id @default(uuid())
  contractId    String
  contract      Contract        @relation(fields: [contractId], references: [id])
  sequence      Int // 1-based
  title         String
  description   String?
  amount        Float // whole won only (BEHAVIOR.md M6)
  dueDate       DateTime // 23:59:59.999 KST of the due date (M12)
  status        MilestoneStatus @default(PENDING)
  fundedAt      DateTime?
  submittedAt   DateTime? // latest submission
  autoApproveAt DateTime? // set only while SUBMITTED
  approvedAt    DateTime?
  approvalType  ApprovalType?
  revisionCount Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  payment        Payment?
  submissions    MilestoneSubmission[]
  settlementItem SettlementItem?

  @@unique([contractId, sequence])
  @@index([status, autoApproveAt])
}

model MilestoneSubmission {
  id             String              @id @default(uuid())
  milestoneId    String
  milestone      Milestone           @relation(fields: [milestoneId], references: [id])
  round          Int
  message        String
  links          String[]
  decision       SubmissionDecision? // null = awaiting review
  decisionReason String?
  decidedAt      DateTime?
  decidedById    String? // null for an automatic approval
  autoDecided    Boolean             @default(false)
  submittedAt    DateTime            @default(now())

  attachments MilestoneAttachment[]

  @@unique([milestoneId, round])
}

model MilestoneAttachment {
  id           String              @id @default(uuid())
  submissionId String
  submission   MilestoneSubmission @relation(fields: [submissionId], references: [id])
  url          String
  fileName     String
  mimeType     String
  size         Int
  createdAt    DateTime            @default(now())

  @@index([submissionId])
}

model Payment {
  id          String        @id @default(uuid())
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id])
  milestoneId String        @unique
  milestone   Milestone     @relation(fields: [milestoneId], references: [id])
  clientId    String
  client      User          @relation("ClientPayments", fields: [clientId], references: [id])
  amount      Float
  status      PaymentStatus @default(PENDING)
  paymentKey  String?
  orderId     String        @unique
  createdAt   DateTime      @default(now())

  @@index([contractId])
}

model SettlementItem {
  id           String      @id @default(uuid())
  milestoneId  String      @unique
  milestone    Milestone   @relation(fields: [milestoneId], references: [id])
  contractId   String
  contract     Contract    @relation(fields: [contractId], references: [id])
  freelancerId String
  freelancer   User        @relation("FreelancerSettlementItems", fields: [freelancerId], references: [id])
  settlementId String? // null = not yet settled
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  grossAmount  Float
  feeRateBps   Int // snapshot at approval; 1000 = 10%
  feeAmount    Float
  feeVatAmount Float
  netAmount    Float
  approvedAt   DateTime
  createdAt    DateTime    @default(now())

  @@index([freelancerId, settlementId])
  @@index([settlementId])
}

model Settlement {
  id                  String           @id @default(uuid())
  freelancerId        String
  freelancer          User             @relation("FreelancerSettlements", fields: [freelancerId], references: [id])
  periodStart         DateTime // Monday 00:00 KST
  periodEnd           DateTime // next Monday 00:00 KST (exclusive)
  scheduledPayoutAt   DateTime
  status              SettlementStatus @default(SCHEDULED)
  itemCount           Int
  grossAmount         Float
  feeAmount           Float
  feeVatAmount        Float
  netAmount           Float
  payoutAttempts      Int              @default(0)
  bankName            String? // account snapshot taken on entering PROCESSING
  accountNumberMasked String?
  accountHolder       String?
  providerReference   String?
  failureReason       String?
  paidAt              DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  items SettlementItem[]

  @@unique([freelancerId, periodStart])
  @@index([status, scheduledPayoutAt])
}

model PayoutAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  bankCode      String // lib/banks.ts
  accountNumber String // digits only, plaintext (BEHAVIOR.md Q22); never returned unmasked
  holderName    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Messaging (BEHAVIOR.md "Conversations") ────────────────────────────────

/// One per contract (MG2), created with the contract (MG3).
model Conversation {
  id            String    @id @default(uuid())
  contractId    String    @unique
  contract      Contract  @relation(fields: [contractId], references: [id])
  /// `createdAt` of the newest message; strictly increasing (MG7). null = no message yet.
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

/// Exactly two per conversation: the contract's client and freelancer (MG2).
model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  /// Read watermark: `createdAt` of the newest counterpart message read (MG16). Never moves back.
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  /// null for SYSTEM messages
  senderId       String?
  sender         User?        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  kind           MessageKind  @default(TEXT)
  /// SYSTEM only: `CONTRACT_CREATED`, `MILESTONE_FUNDED`, … (MG6). A bare String like `Notification.type`.
  systemEvent    String?
  /// '' when a message carries only attachments
  body           String
  /// Soft delete by the sender within 5 minutes (MG17)
  deletedAt      DateTime?
  /// Server clock after the conversation lock; strictly increasing per conversation (MG7)
  createdAt      DateTime     @default(now())

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  url       String
  /// Original name restored to UTF-8 (rule 12); never part of the storage key
  fileName  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([messageId])
}

// ─── Profile (BEHAVIOR.md "Portfolio and careers") ──────────────────────────

model PortfolioItem {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  description String?
  url         String?
  imageUrl    String?
  /// The freelancer's role in the work, e.g. "프론트엔드 리드"
  role        String?
  /// normalizeSkillList-normalized (PF1)
  skills      String[]
  /// First instant of the month in KST (PF2); returned as `YYYY-MM`
  startedAt   DateTime?
  endedAt     DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, sortOrder])
}

model Career {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  company        String
  position       String
  employmentType EmploymentType
  /// First instant of the month in KST (PF2); returned as `YYYY-MM`
  startDate      DateTime
  /// null = current position
  endDate        DateTime?
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, startDate])
}

model Review {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("RevieweeReviews", fields: [revieweeId], references: [id])
  rating     Int
  content    String
  tags       String[]
  createdAt  DateTime @default(now())

  @@unique([contractId, reviewerId])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model PricingAnalysis {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id])
  features        Json
  totalAmount     Float
  summary         String?
  marketReference String?
  createdAt       DateTime @default(now())
}

// ─── Infrastructure ─────────────────────────────────────────────────────────

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED // maxAttempts exhausted, or PermanentJobError
  CANCELLED
}

/// Postgres-backed job queue. See BEHAVIOR.md "Background jobs".
model Job {
  id          String    @id @default(uuid())
  /// TS union `JobType` (src/jobs/types.ts) — a bare String like `Notification.type`.
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  /// Worker id: `${hostname}:${pid}:${random}`
  lockedBy    String?
  lastError   String?
  /// Enqueueing an existing key is a no-op (ON CONFLICT DO NOTHING).
  dedupeKey   String?   @unique
  /// requestId of the request that enqueued the job.
  traceId     String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

/// Fixed-window rate-limit counters, shared across server instances.
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
