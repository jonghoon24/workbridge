generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  FREELANCER
}

enum ProjectStatus {
  UPCOMING
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

enum MilestoneStatus {
  PENDING // planned, not funded
  FUNDED // paid into escrow, work in progress
  SUBMITTED // deliverable submitted, awaiting review
  REVISION_REQUESTED // rejected, awaiting resubmission
  APPROVED // approved manually or automatically; terminal
}

enum ApprovalType {
  MANUAL
  AUTO
}

enum SubmissionDecision {
  APPROVED
  REJECTED
}

enum SettlementStatus {
  SCHEDULED // created by the weekly batch, awaiting its payout date
  PROCESSING // transfer in flight
  PAID
  FAILED // transfer failed; retried while attempts remain
  ON_HOLD // no payout account (or the freelancer is soft-deleted)
}

enum MessageKind {
  TEXT // written by a participant
  SYSTEM // contract/milestone event log; no sender
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  FREELANCE
  INTERN
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String?
  name             String
  role             Role
  roleSelected     Boolean   @default(true)
  profileImage     String?
  bio              String?
  companyName      String?
  businessField    String?
  website          String?
  skills           String[]
  activityCategory String?
  experienceYears  Int?
  hourlyRate       Float?
  portfolioUrl     String?
  googleId         String?   @unique
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  clientProjects      Project[]                 @relation("ClientProjects")
  applications        Application[]             @relation("FreelancerApplications")
  clientContracts     Contract[]                @relation("ClientContracts")
  freelancerContracts Contract[]                @relation("FreelancerContracts")
  clientPayments      Payment[]                 @relation("ClientPayments")
  givenReviews        Review[]                  @relation("ReviewerReviews")
  receivedReviews     Review[]                  @relation("RevieweeReviews")
  projectBookmarks    ProjectBookmark[]
  notifications       Notification[]
  settlementItems     SettlementItem[]          @relation("FreelancerSettlementItems")
  settlements         Settlement[]              @relation("FreelancerSettlements")
  payoutAccount       PayoutAccount?
  conversations       ConversationParticipant[]
  sentMessages        Message[]                 @relation("SentMessages")
  portfolioItems      PortfolioItem[]
  careers             Career[]
  notificationPrefs   NotificationPreference[]
  emailDeliveries     EmailDelivery[]
  attachmentUploads   AttachmentUpload[]
}

model Project {
  id                   String        @id @default(uuid())
  title                String
  description          String
  category             String
  budget               Float
  recruitmentStartDate DateTime?
  deadline             DateTime
  requiredSkills       String[]
  status               ProjectStatus @default(OPEN)
  clientId             String
  client               User          @relation("ClientProjects", fields: [clientId], references: [id])
  deletedAt            DateTime?
  createdAt            DateTime      @default(now())

  applications    Application[]
  contract        Contract?
  pricingAnalysis PricingAnalysis?
  bookmarks       ProjectBookmark[]

  // GET /api/projects: status filter + one index per sort (latest, deadline, budget).
  // [status, deadline] also serves the lifecycle sweep (status IN (UPCOMING, OPEN), deadline < now).
  @@index([status, createdAt])
  @@index([status, deadline])
  @@index([status, budget])
  @@index([clientId]) // GET /api/users/me/projects
}

model ProjectBookmark {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId, createdAt])
}

model Application {
  id               String            @id @default(uuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  freelancerId     String
  freelancer       User              @relation("FreelancerApplications", fields: [freelancerId], references: [id])
  coverLetter      String
  expectedRate     Float
  expectedDuration String
  status           ApplicationStatus @default(PENDING)
  createdAt        DateTime          @default(now())

  contract Contract?

  @@unique([projectId, freelancerId])
  @@index([freelancerId]) // GET /api/users/me/applications
}

model Contract {
  id               String         @id @default(uuid())
  projectId        String         @unique
  project          Project        @relation(fields: [projectId], references: [id])
  applicationId    String         @unique
  application      Application    @relation(fields: [applicationId], references: [id])
  clientId         String
  client           User           @relation("ClientContracts", fields: [clientId], references: [id])
  freelancerId     String
  freelancer       User           @relation("FreelancerContracts", fields: [freelancerId], references: [id])
  amount           Float
  startDate        DateTime
  endDate          DateTime
  clientSigned     Boolean        @default(false)
  freelancerSigned Boolean        @default(false)
  status           ContractStatus @default(PENDING)
  completedAt      DateTime?
  createdAt        DateTime       @default(now())

  milestones      Milestone[]
  payments        Payment[]
  settlementItems SettlementItem[]
  reviews         Review[]
  conversation    Conversation?

  // GET /api/contracts: OR [{ clientId }, { freelancerId }] — one index per arm (bitmap OR).
  @@index([clientId])
  @@index([freelancerId])
}

model Milestone {
  id            String          @id @default(uuid())
  contractId    String
  contract      Contract        @relation(fields: [contractId], references: [id])
  sequence      Int // 1-based
  title         String
  description   String?
  amount        Float // whole won only (docs/domain/milestones-payments.md)
  dueDate       DateTime // 23:59:59.999 KST of the due date
  status        MilestoneStatus @default(PENDING)
  fundedAt      DateTime?
  submittedAt   DateTime? // latest submission
  autoApproveAt DateTime? // set only while SUBMITTED
  approvedAt    DateTime?
  approvalType  ApprovalType?
  revisionCount Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  payment        Payment?
  submissions    MilestoneSubmission[]
  settlementItem SettlementItem?

  @@unique([contractId, sequence])
  @@index([status, autoApproveAt])
}

model MilestoneSubmission {
  id             String              @id @default(uuid())
  milestoneId    String
  milestone      Milestone           @relation(fields: [milestoneId], references: [id])
  round          Int
  message        String
  links          String[]
  decision       SubmissionDecision? // null = awaiting review
  decisionReason String?
  decidedAt      DateTime?
  decidedById    String? // null for an automatic approval
  autoDecided    Boolean             @default(false)
  submittedAt    DateTime            @default(now())

  attachments MilestoneAttachment[]

  @@unique([milestoneId, round])
}

model MilestoneAttachment {
  id           String              @id @default(uuid())
  submissionId String
  submission   MilestoneSubmission @relation(fields: [submissionId], references: [id])
  /// Key in the private attachment bucket; null for a legacy row stored in the public bucket
  storageKey   String?             @unique
  /// Legacy public URL; null once the file lives in the private bucket (`storageKey`)
  url          String?
  fileName     String
  mimeType     String
  size         Int
  createdAt    DateTime            @default(now())

  @@index([submissionId])
}

model Payment {
  id          String        @id @default(uuid())
  contractId  String
  contract    Contract      @relation(fields: [contractId], references: [id])
  milestoneId String        @unique
  milestone   Milestone     @relation(fields: [milestoneId], references: [id])
  clientId    String
  client      User          @relation("ClientPayments", fields: [clientId], references: [id])
  amount      Float
  status      PaymentStatus @default(PENDING)
  paymentKey  String?
  orderId     String        @unique
  createdAt   DateTime      @default(now())

  @@index([contractId])
  @@index([clientId]) // GET /api/payments
}

model SettlementItem {
  id           String      @id @default(uuid())
  milestoneId  String      @unique
  milestone    Milestone   @relation(fields: [milestoneId], references: [id])
  contractId   String
  contract     Contract    @relation(fields: [contractId], references: [id])
  freelancerId String
  freelancer   User        @relation("FreelancerSettlementItems", fields: [freelancerId], references: [id])
  settlementId String? // null = not yet settled
  settlement   Settlement? @relation(fields: [settlementId], references: [id])
  grossAmount  Float
  feeRateBps   Int // snapshot at approval; 1000 = 10%
  feeAmount    Float
  feeVatAmount Float
  netAmount    Float
  approvedAt   DateTime
  createdAt    DateTime    @default(now())

  @@index([freelancerId, settlementId])
  @@index([settlementId])
}

model Settlement {
  id                  String           @id @default(uuid())
  freelancerId        String
  freelancer          User             @relation("FreelancerSettlements", fields: [freelancerId], references: [id])
  periodStart         DateTime // Monday 00:00 KST
  periodEnd           DateTime // next Monday 00:00 KST (exclusive)
  scheduledPayoutAt   DateTime
  status              SettlementStatus @default(SCHEDULED)
  itemCount           Int
  grossAmount         Float
  feeAmount           Float
  feeVatAmount        Float
  netAmount           Float
  payoutAttempts      Int              @default(0)
  bankName            String? // account snapshot taken on entering PROCESSING
  accountNumberMasked String?
  accountHolder       String?
  providerReference   String?
  failureReason       String?
  paidAt              DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  items SettlementItem[]

  @@unique([freelancerId, periodStart])
  @@index([status, scheduledPayoutAt])
}

model PayoutAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  bankCode      String // lib/banks.ts
  accountNumber String // digits only, plaintext (#28); never returned unmasked
  holderName    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Messaging (docs/domain/messaging-notifications.md) ────────────────────

/// One per contract, created in the same transaction as the contract.
model Conversation {
  id            String    @id @default(uuid())
  contractId    String    @unique
  contract      Contract  @relation(fields: [contractId], references: [id])
  /// `createdAt` of the newest message; strictly increasing. null = no message yet.
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

/// Exactly two per conversation: the contract's client and freelancer.
model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  /// Read watermark: `createdAt` of the newest counterpart message read. Never moves back.
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  /// null for SYSTEM messages
  senderId       String?
  /// `onDelete: Restrict` on purpose: the default SetNull would turn a TEXT message into a
  /// sender-less pseudo-system message. Users are only ever soft-deleted.
  sender         User?        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  kind           MessageKind  @default(TEXT)
  /// SYSTEM only: `CONTRACT_CREATED`, `MILESTONE_FUNDED`, …. A bare String like `Notification.type`.
  systemEvent    String?
  /// '' when a message carries only attachments
  body           String
  /// Soft delete by the sender within 5 minutes
  deletedAt      DateTime?
  /// Server clock after the conversation lock; strictly increasing per conversation
  createdAt      DateTime     @default(now())

  attachments MessageAttachment[]

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id])
  /// Key in the private attachment bucket; null for a legacy row stored in the public bucket
  storageKey String?  @unique
  /// Legacy public URL; null once the file lives in the private bucket (`storageKey`)
  url        String?
  /// Original name restored to UTF-8; never part of the storage key
  fileName   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([messageId])
}

/// An upload URL issued for one attachment that is not attached yet (docs/domain/messaging-notifications.md
/// "첨부 파일"). Deleted when a message or submission claims it; expired rows are swept by `maintenance.cleanup`.
model AttachmentUpload {
  id         String                @id @default(uuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id])
  scope      AttachmentUploadScope
  /// The conversation (MESSAGE) or milestone (MILESTONE_SUBMISSION) the file may be attached to
  targetId   String
  storageKey String                @unique
  fileName   String
  /// Declared by the browser; the claim re-reads the stored object's type and size
  mimeType   String
  size       Int
  expiresAt  DateTime
  createdAt  DateTime              @default(now())

  @@index([userId, scope, targetId])
  @@index([expiresAt])
}

enum AttachmentUploadScope {
  MESSAGE
  MILESTONE_SUBMISSION
}

// ─── Profile: portfolio and careers (docs/domain/accounts.md) ──────────────

model PortfolioItem {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  description String?
  url         String?
  imageUrl    String?
  /// The freelancer's role in the work, e.g. "프론트엔드 리드"
  role        String?
  /// normalizeSkillList-normalized
  skills      String[]
  /// First instant of the month in KST; returned as `YYYY-MM`
  startedAt   DateTime?
  endedAt     DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, sortOrder])
}

model Career {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  company        String
  position       String
  employmentType EmploymentType
  /// First instant of the month in KST; returned as `YYYY-MM`
  startDate      DateTime
  /// null = current position
  endDate        DateTime?
  description    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, startDate])
}

model Review {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("RevieweeReviews", fields: [revieweeId], references: [id])
  rating     Int
  content    String
  tags       String[]
  createdAt  DateTime @default(now())

  @@unique([contractId, reviewerId])
  @@index([revieweeId]) // GET /api/reviews/users/:id and the profile rating average
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  emailDeliveries EmailDelivery[]

  @@index([userId, readAt, createdAt])
}

model PricingAnalysis {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id])
  features        Json
  totalAmount     Float
  summary         String?
  marketReference String?
  createdAt       DateTime @default(now())
}

// ─── Notification channels (docs/domain/messaging-notifications.md) ────────

enum EmailDeliveryStatus {
  PENDING // created by notify(), awaiting its `notification.email` job
  SENT
  FAILED // the provider threw on the last attempt, or MAIL_PROVIDER is unsupported
  SKIPPED // the recipient was soft-deleted before the send; the provider was not called
}

/// Sparse per-user overrides of the notification policy: a row exists only while a channel
/// departs from its default. No backfill — a user without rows gets the defaults.
model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// `NotificationType` (TS union), a bare String like `Notification.type`
  type      String
  /// null = follow the policy default; never stored for a locked channel
  inApp     Boolean?
  /// null = follow the policy default; never stored for a locked channel
  email     Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

/// One email, from `notify()` to the provider. The audit trail of what was sent;
/// no route reads it and nothing deletes it (#26).
model EmailDelivery {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  /// The in-app row created by the same notify() call; null when in-app is off or absent
  notificationId    String?
  notification      Notification?       @relation(fields: [notificationId], references: [id])
  type              String
  /// The recipient's address when the row was created
  toAddress         String
  subject           String
  body              String
  /// 'conversation:<id>' for MESSAGE_UNREAD_DIGEST (the digest's throttle lookup); null otherwise
  contextKey        String?
  status            EmailDeliveryStatus @default(PENDING)
  /// Provider calls made; incremented just before each call
  attempts          Int                 @default(0)
  /// MAIL_PROVIDER value of the last send, e.g. 'log'
  provider          String?
  providerMessageId String?
  /// At most 2,000 characters
  error             String?
  sentAt            DateTime?
  /// notify()'s `now` (a job's ctx.now), so the digest throttle is deterministic
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, type, contextKey, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

// ─── Infrastructure ─────────────────────────────────────────────────────────

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED // maxAttempts exhausted, or PermanentJobError
  CANCELLED
}

/// Postgres-backed job queue. See docs/domain/jobs.md.
model Job {
  id          String    @id @default(uuid())
  /// TS union `JobType` (src/jobs/types.ts) — a bare String like `Notification.type`.
  type        String
  payload     Json      @default("{}")
  status      JobStatus @default(PENDING)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  /// Worker id: `${hostname}:${pid}:${random}`
  lockedBy    String?
  lastError   String?
  /// Enqueueing an existing key is a no-op (ON CONFLICT DO NOTHING).
  dedupeKey   String?   @unique
  /// requestId of the request that enqueued the job.
  traceId     String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, status])
}

/// Fixed-window rate-limit counters, shared across server instances.
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
