PORT=4000

DATABASE_URL=postgresql://user:password@host:5432/workbridge?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/workbridge

JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# true면 Google 재인증이 Google의 로그인 시각(auth_time)을 반드시 요구한다. 인증된 앱에서 "Session age claims"를 켠 뒤에만 켠다(docs/ENV.md).
GOOGLE_REAUTH_REQUIRE_AUTH_TIME=false
TOSS_SECRET_KEY=test_sk_your_toss_secret_key
ALLOW_PAYMENT_BYPASS=false
# 프론트엔드 출처 하나. Google 로그인 리디렉션, 메일 링크, CORS가 이 값을 쓴다. 목록은 받지 않는다.
CLIENT_URL=http://localhost:3000
# 추가 CORS 출처, 쉼표로 구분(선택). 추가 출처는 여기에만 둔다.
CORS_ORIGINS=
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# 지급 계좌번호 암호화 키(AES-256, 32바이트 base64). `openssl rand -base64 32`로 만든다. 지급 계좌 저장·조회와
# 지급, 시드(`npm run db:seed`)에 필요하다. 바꾸면 이미 저장된 계좌번호를 읽지 못한다(로컬은 다시 시드하면 된다).
PAYOUT_ACCOUNT_ENCRYPTION_KEY=
# 메시지·결과물 첨부의 비공개 버킷(기본 workbridge-attachments). 프로필·포트폴리오 이미지는 공개 버킷 workbridge.
SUPABASE_ATTACHMENT_BUCKET=workbridge-attachments

# 인프라 (모두 선택)
LOG_LEVEL=info
# Next.js 프록시가 보낸 X-Forwarded-For를 믿는다. 프록시는 클라이언트가 보낸 헤더를 그대로 넘기므로,
# `loopback`은 Next 포트에 믿을 수 있는 클라이언트만 닿을 때만 안전하다
# (그렇지 않으면 클라이언트가 요청 제한에 쓰일 IP를 스스로 고른다).
TRUST_PROXY=loopback
# Next.js 프록시와 같은 값을 넣으면, 프록시가 X-Client-IP로 보낸 브라우저 IP를 믿는다(Vercel 전용).
# 로컬은 비워 둔다.
PROXY_SHARED_SECRET=
# 로컬에서는 로그인이 모두 loopback에서 와서 15분에 20회 한도 하나를 나눠 쓴다. 로그인을 반복하는
# E2E나 스크립트를 돌릴 때는 false로 둔다.
RATE_LIMIT_ENABLED=true
# 비어 있으면 POST /api/internal/jobs/run이 404로 답한다.
INTERNAL_JOB_TOKEN=
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=5000
# 정산 지급과 메일 발송 작업(docs/domain/jobs.md). 정확히 true일 때만 돈다. 비우면 꺼진다(운영 기본값).
# 로컬은 켜 둔다: 지급은 로그 provider라 돈이 오가지 않고, 메일은 로그에만 쓴다.
JOB_PAYOUT_ENABLED=true
JOB_EMAIL_ENABLED=true
# 산출물 제출부터 자동 승인까지 일수(양의 정수, 기본 7).
MILESTONE_AUTO_APPROVE_DAYS=7
# 이메일. 비우거나 `log`면 보내지 않고 이메일마다 로그에 쓴다 —
# 실제 메일 서비스는 연결돼 있지 않다. 그 밖의 값은 지원하지 않는다: 시작할 때 warn 한 줄,
# 그리고 발송은 모두 실패한다.
MAIL_PROVIDER=log
MAIL_FROM=WorkBridge <no-reply@workbridge.local>
# 오류 보고(docs/DEPLOYMENT.md "Sentry"). DSN이 비어 있으면 꺼지고 @sentry/node를 불러오지 않는다.
# 환경 이름은 VERCEL_ENV, 다음 NODE_ENV, 다음 development 순으로 정한다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
