PORT=4000

DATABASE_URL=postgresql://user:password@host:5432/workbridge?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/workbridge

JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
OPENAI_API_KEY=your_openai_api_key
TOSS_SECRET_KEY=test_sk_your_toss_secret_key
ALLOW_PAYMENT_BYPASS=false
CLIENT_URL=http://localhost:3000
# Extra CORS origins, comma-separated (optional). Keep CLIENT_URL a single origin: OAuth
# redirects use it verbatim (BEHAVIOR.md Q26).
CORS_ORIGINS=
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Infrastructure (all optional)
LOG_LEVEL=info
# Trust X-Forwarded-For from the Next.js proxy. The proxy forwards that header as the client
# sent it, so `loopback` is safe only while the Next port is reachable solely by trusted clients
# (otherwise clients pick their own rate-limit IP; BEHAVIOR.md Q23).
TRUST_PROXY=loopback
# Locally every login comes from loopback and shares one 20-per-15-minutes budget; set false
# for demos and scripts that log in repeatedly.
RATE_LIMIT_ENABLED=true
# Unset → POST /api/internal/jobs/run answers 404.
INTERNAL_JOB_TOKEN=
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=5000
# Days from a deliverable submission to auto-approval (positive integer, default 7).
MILESTONE_AUTO_APPROVE_DAYS=7
# Email (BEHAVIOR.md NC14). Empty or `log` writes each email to the log instead of sending it —
# no real mail service is connected. Any other value is unsupported: a warn at start, and every
# send fails.
MAIL_PROVIDER=log
MAIL_FROM=WorkBridge <no-reply@workbridge.local>
# Error reporting (docs/DEPLOYMENT.md "Sentry"). Empty DSN → off, @sentry/node is never loaded.
# Environment defaults to VERCEL_ENV, then NODE_ENV, then development.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
