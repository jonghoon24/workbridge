PORT=4000

DATABASE_URL=postgresql://user:password@host:5432/workbridge?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/workbridge

JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
OPENAI_API_KEY=your_openai_api_key
TOSS_SECRET_KEY=test_sk_your_toss_secret_key
ALLOW_PAYMENT_BYPASS=false
CLIENT_URL=http://localhost:3000
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Infrastructure (all optional)
LOG_LEVEL=info
# Trust X-Forwarded-For from the local Next.js proxy so rate limits see the browser's IP.
TRUST_PROXY=loopback
RATE_LIMIT_ENABLED=true
# Unset → POST /api/internal/jobs/run answers 404.
INTERNAL_JOB_TOKEN=
JOB_WORKER_ENABLED=true
JOB_POLL_INTERVAL_MS=5000
