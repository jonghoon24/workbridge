# WorkBridge 서버 환경변수. 로컬에서는 이 파일을 .env로 복사해 쓴다.
# 변수마다 의미와 형식은 이 파일의 주석이 원본이다. 필수 여부와 기본값은 src/env.ts가 정한다.
# 프리뷰·프로덕션과 GitHub 시크릿에 무엇을 넣는지는 docs/ENV.md에 있다.
# 서버가 읽는 변수는 모두 이 파일에 있어야 한다. 플랫폼이 넣는 변수는 `# KEY=`처럼 주석으로 둔다.

# --- 서버 실행과 플랫폼 ---

# 로컬 개발 서버의 포트. Vercel에서는 쓰지 않는다.
PORT=4000

# 아래 셋은 직접 넣지 않는다. Vercel이 넣는다.
#
# Vercel이 1을 넣는다. 이때만 서버가 X-Vercel-Forwarded-For를 클라이언트 IP로 믿는다(src/lib/clientIp.ts).
# VERCEL=
# Vercel이 production, preview, development 중 하나를 넣는다.
# API 문서(GET /api/docs)를 열지 정하는 데 쓴다. 조건은 src/controllers/docs.controller.ts에 있다.
# Sentry 환경 이름의 두 번째 후보이기도 하다(아래 SENTRY_ENVIRONMENT).
# VERCEL_ENV=
# Vercel이 Git 연동 배포에서 커밋 SHA를 넣는다. Sentry의 release로 쓴다.
# VERCEL_GIT_COMMIT_SHA=

# --- 데이터베이스 (src/env.ts가 아니라 Prisma가 schema.prisma의 env()로 읽는다) ---

# 앱이 쿼리에 쓰는 연결 문자열. 로컬은 로컬 Postgres를 가리킨다(사용자 이름은 로컬 설치에 맞춘다).
#
# Supabase(프리뷰·프로덕션)에서는 Transaction pooler 주소를 쓴다. 포트는 6543이다.
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=3
# pgbouncer=true는 Prisma가 트랜잭션 단위 풀러에 맞게 prepared statement를 쓰지 않게 한다.
# connection_limit=3은 Vercel 함수 인스턴스 하나가 여는 연결 수를 정한다.
# 이 값이 없으면 Prisma는 인스턴스마다 CPU 수 × 2 + 1개를 연다. 그러면 인스턴스가 늘 때 Supavisor 연결 한도에 먼저 닿는다.
# 1은 쓰지 않는다. 연결이 하나뿐이면 Promise.all로 동시에 보낸 쿼리가 차례로 돈다.
# 또 트랜잭션 콜백 안에서 tx가 아니라 루트 prisma로 쿼리하는 코드가 있으면 멈춘다.
# 트랜잭션이 유일한 연결을 쥔 채, 그 쿼리가 두 번째 연결을 기다리기 때문이다. 결국 트랜잭션 시간 한도가 지나 실패한다.
# 연결을 기다리는 시간을 바꾸려면 &pool_timeout=10처럼 붙인다. 로컬은 이 옵션들이 필요 없다.
DATABASE_URL=postgresql://postgres@localhost:5432/workbridge

# prisma migrate가 쓰는 연결 문자열(schema.prisma의 directUrl).
# prisma migrate는 세션 단위 연결이 필요해서 Transaction pooler로는 돌지 않는다.
# 그래서 Supabase에서는 Session pooler 주소를 쓴다. 포트는 5432다.
#   postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# 로컬에서는 DATABASE_URL과 같게 둔다.
DIRECT_URL=postgresql://postgres@localhost:5432/workbridge

# --- 인증 ---

# 액세스 토큰과 리프레시 토큰의 서명 시크릿.
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
# 토큰 만료 시간. jsonwebtoken의 expiresIn 형식(15m, 7d 등)이다.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 클라이언트. 만드는 법은 docs/ENV.md "Google OAuth".
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# 백엔드가 아니라 프론트엔드의 /api/auth/google/callback 주소다.
# Google이 브라우저를 프론트엔드로 돌려보내고, Next 프록시가 그 요청을 서버로 넘긴다.
# 로그인과 재인증이 같은 콜백을 쓴다.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# 재인증은 Google 전용 계정이 탈퇴하기 전에 Google 로그인을 한 번 더 거치는 확인이다.
# 정확히 true일 때만, 재인증은 Google이 ID 토큰에 넣는 로그인 시각(auth_time)을 반드시 요구한다.
# 그 밖의 값이면 로그인 시각이 없어도 연결된 Google 계정으로 다녀온 것을 받고 warn 로그를 남긴다.
# Google은 게시·인증된 앱이 "Session age claims"를 켰을 때만 auth_time을 준다(docs/ENV.md "Google OAuth").
# 그 조건 없이 true로 두면 Google 전용 회원은 탈퇴할 수 없다. 프로덕션 상태는 docs/DEPLOYMENT.md
# "Google 전용 계정의 재인증은 로그인 시각을 확인하지 못한다".
GOOGLE_REAUTH_REQUIRE_AUTH_TIME=false

# --- 프론트엔드 출처 ---

# 프론트엔드의 출처(origin) 하나. 끝의 /는 괜찮다.
# Google 로그인 리디렉션, 메일 본문의 링크, CORS 허용 출처가 모두 이 값을 쓴다(src/lib/clientUrl.ts).
# 쉼표로 이은 목록, 경로가 붙은 주소, 스킴이 없는 값은 받지 않는다.
# 값이 비었거나 이런 형태여도 서버는 뜨고 시작할 때 warn을 남긴다. 그러면 다음이 실패한다.
#   - Google 로그인이 500으로 끝난다.
#   - 메일 발송 기록이 FAILED로 남는다.
#   - 브라우저가 백엔드를 직접 부르면 CORS로 막힌다. 보통의 흐름은 같은 출처의 Next 프록시를 거치므로 해당하지 않는다.
CLIENT_URL=http://localhost:3000
# CLIENT_URL 말고 더 허용할 CORS 출처. 쉼표로 구분한다. 선택이다.
# 커스텀 도메인 같은 추가 출처는 CLIENT_URL이 아니라 여기에 둔다.
CORS_ORIGINS=

# --- 결제 (토스페이먼츠) ---

# 토스페이먼츠 시크릿 키. 테스트 키는 test_sk_로 시작한다. 발급은 docs/ENV.md "토스페이먼츠".
TOSS_SECRET_KEY=test_sk_your_toss_secret_key
# true면 토스 결제창 없이 마일스톤을 결제 완료로 만드는 POST /api/payments/dev-complete가 열린다.
# 돈을 받지 않고 결제를 끝내는 경로다. 켜도 되는 곳은 로컬과 E2E뿐이고, 프리뷰·프로덕션에서는 반드시 false다.
# 로컬에서 결제 우회를 쓰려면 직접 true로 바꾼다.
# 클라이언트의 NEXT_PUBLIC_ALLOW_PAYMENT_BYPASS와 함께 바꾼다.
ALLOW_PAYMENT_BYPASS=false

# --- Supabase Storage ---

# Supabase 프로젝트 URL과 Secret Key(sb_secret_로 시작). 버킷 만드는 법은 docs/ENV.md "Supabase".
# src/middlewares/upload.ts가 import될 때 Supabase 클라이언트를 만들므로, 이 둘이 없으면 서버가 뜨지 않는다.
# 로컬에서 Storage를 쓰지 않으면 아래 더미 값 그대로 두면 된다.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# 메시지 첨부와 마일스톤 결과물 첨부를 두는 비공개 버킷의 이름.
# 기본 이름(src/env.ts)으로 버킷을 만들었다면 비워 둬도 된다.
# 프로필·포트폴리오 이미지는 이 버킷이 아니라 공개 버킷 workbridge에 둔다.
SUPABASE_ATTACHMENT_BUCKET=workbridge-attachments

# --- 지급 계좌 ---

# 지급 계좌번호를 저장할 때 쓰는 AES-256 암호화 키. 32바이트를 base64로 쓴 값이다.
#   openssl rand -base64 32
# 비어도 서버는 뜬다. 그러나 지급 계좌 등록·조회와 지급 작업이 실패한다.
# 시드(npm run db:seed)는 아무것도 지우기 전에 멈춘다.
# 키를 바꾸거나 잃으면 이미 저장된 계좌번호를 읽지 못한다. 로컬은 다시 시드하면 된다.
# 프리뷰·프로덕션의 키 관리와 교체는 docs/DEPLOYMENT.md "지급 계좌 암호화 키".
PAYOUT_ACCOUNT_ENCRYPTION_KEY=

# --- 클라이언트 IP와 요청 제한 ---
# 클라이언트 IP를 정하는 순서와 Vercel에서의 동작은 docs/DEPLOYMENT.md "클라이언트 IP"에 있다.

# Express의 trust proxy 값(loopback, 홉 수, 주소 목록 등). 비우면 소켓 주소를 클라이언트 IP로 쓴다.
# 값이 있으면 X-Forwarded-For에서 신뢰한 프록시를 뺀 주소를 클라이언트 IP로 쓴다. 이 IP가 요청 제한의 키다.
# 로컬은 Next 개발 서버가 같은 기기에서 요청을 넘기므로 loopback이다.
# Next 프록시는 클라이언트가 보낸 X-Forwarded-For를 그대로 넘긴다. 그래서 Next 포트에 아무나 닿을 수 있으면
# loopback은 안전하지 않다. 클라이언트가 X-Forwarded-For로 요청 제한 키(IP)를 직접 고를 수 있기 때문이다.
TRUST_PROXY=loopback
# Next 프록시와 나누는 공유 비밀. 클라이언트의 같은 이름 변수와 같은 값이어야 한다.
# 프록시가 보낸 X-Proxy-Secret이 이 값과 같을 때만, 서버는 X-Client-IP의 브라우저 IP를 믿는다.
# 비우면 X-Client-IP를 무시한다. 프록시는 Vercel에서만 이 헤더를 보내므로 로컬은 비워 둔다.
# 값 만들기: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
PROXY_SHARED_SECRET=
# 정확히 false면 로그인과 비밀번호 확인의 요청 제한을 끈다. 한도는 src/lib/rateLimitRules.ts에 있다.
# 로컬에서는 모든 로그인이 루프백 한 주소에서 와서 한도 하나를 나눠 쓴다.
# 로그인을 반복하는 수동 확인이나 스크립트를 돌릴 때는 false로 둔다.
RATE_LIMIT_ENABLED=true

# --- 작업 큐 (docs/domain/jobs.md) ---

# POST /api/internal/jobs/run이 X-Internal-Token 헤더로 받는 토큰.
# 비우면 이 엔드포인트가 404로 답해 존재를 숨긴다.
# 프로덕션 값은 GitHub 시크릿 PROD_INTERNAL_JOB_TOKEN과 같아야 크론(.github/workflows/jobs.yml)이 돈다.
INTERNAL_JOB_TOKEN=
# 정확히 false면 개발 서버(npm run dev)가 작업 큐 워커를 띄우지 않는다.
# 프로덕션(NODE_ENV=production)과 테스트에서는 이 값과 상관없이 워커가 뜨지 않는다.
JOB_WORKER_ENABLED=true
# 개발 워커가 큐를 확인하는 간격(밀리초).
JOB_POLL_INTERVAL_MS=5000
# 정확히 true일 때만 settlement.payout(정산 지급) 작업이 돈다. 비우면 꺼진다.
# 지금 지급 provider는 돈을 보내지 않고 정산을 PAID로 만든다. 그래서 프로덕션에서는 꺼 둔다.
# 로컬은 켜 둔다. 꺼졌을 때의 동작과 켜는 조건은 docs/DEPLOYMENT.md "작업 큐는 15분마다 돈다".
JOB_PAYOUT_ENABLED=true
# 정확히 true일 때만 notification.email 작업이 메일을 보낸다. 꺼져 있으면 발송 기록이 SKIPPED로 끝난다.
# 지금 메일 provider는 받는 주소와 본문을 로그에 쓴다. 프로덕션 로그에 개인정보가 남으므로 프로덕션에서는 꺼 둔다(#26).
# 로컬은 켜 둔다.
JOB_EMAIL_ENABLED=true
# 산출물을 제출한 뒤 자동 승인까지의 일수. 양의 정수이고 하루는 24시간이다.
# 양의 정수가 아니면 기본값을 쓴다(src/services/milestones.service.ts의 autoApproveDays).
MILESTONE_AUTO_APPROVE_DAYS=7

# --- 메일 ---

# 메일 provider. 지원하는 값은 log뿐이고, 비워도 log다.
# log provider는 메일을 보내지 않고 받는 주소와 본문을 info 로그 mail.sent 한 줄로 남긴다.
# 그 밖의 값을 넣으면 서버가 시작할 때 warn을 한 줄 남기고, 모든 발송이 FAILED가 된다.
MAIL_PROVIDER=log
# 모든 메일의 From. 메일 본문의 링크는 이 값이 아니라 CLIENT_URL을 기준으로 만든다.
MAIL_FROM=WorkBridge <no-reply@workbridge.local>

# --- 로그와 오류 보고 ---

# 로그 레벨: debug, info, warn, error, silent. 테스트는 error로 돈다(vitest.config.ts).
LOG_LEVEL=info
# Sentry DSN. 선택이다. 비우면 오류 보고가 꺼지고 @sentry/node를 불러오지 않는다.
# 무엇을 보내는지는 docs/DEPLOYMENT.md "Sentry".
SENTRY_DSN=
# Sentry의 environment. 선택이다. 비우면 VERCEL_ENV, NODE_ENV, development 순으로 정한다.
SENTRY_ENVIRONMENT=
