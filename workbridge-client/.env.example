# WorkBridge 클라이언트 환경변수. 로컬에서는 이 파일을 .env.local로 복사해 쓴다.
# 변수마다 의미와 형식은 이 파일의 주석이 원본이다. 프리뷰·프로덕션에 무엇을 넣는지는 docs/ENV.md에 있다.
# 클라이언트가 읽는 변수는 모두 이 파일에 있어야 한다. 플랫폼이 넣는 변수는 `# KEY=`처럼 주석으로 둔다.
# NEXT_PUBLIC_로 시작하는 값은 빌드할 때 브라우저 번들에 들어간다. 바꾸면 다시 빌드해야 한다.
# 그 밖의 값은 서버 쪽(Next 라우트 핸들러와 SSR)에서만 읽는다.

# --- 백엔드 주소 ---
# 서버 쪽 코드가 백엔드 주소를 고르는 우선순위는 src/lib/apiUrl.js 머리 주석에 있다.
# 브라우저는 이 주소를 직접 부르지 않고 같은 출처의 /api/*를 부른다.

# 백엔드 API 주소. API_URL도 Related Projects 값도 없을 때 쓴다(로컬, CLI 배포).
NEXT_PUBLIC_API_URL=http://localhost:4000
# 서버 쪽 전용 백엔드 주소. 선택이다. 값이 있으면 다른 후보보다 먼저 쓴다.
# 프리뷰에는 넣지 않는다. 넣으면 같은 브랜치의 서버 프리뷰를 찾는 Related Projects 값보다 먼저 쓰인다.
API_URL=
# Vercel이 vercel.json의 relatedProjects를 보고 서버 프로젝트의 주소들을 넣는다(Git 연동 배포에서만).
# VERCEL_RELATED_PROJECTS=

# --- 클라이언트 IP 전달 ---

# 서버 쪽 전용. 백엔드의 같은 이름 변수와 같은 값이어야 한다.
# Vercel에서만 Next 프록시가 브라우저 IP를 X-Client-IP 헤더에, 이 값을 X-Proxy-Secret 헤더에 담아 백엔드로 보낸다.
# 로컬은 비워 둔다. 값 만들기와 동작은 workbridge-server/.env.example의 PROXY_SHARED_SECRET.
PROXY_SHARED_SECRET=
# Vercel이 1을 넣는다. 이때만 프록시가 X-Vercel-Forwarded-For를 브라우저 IP로 믿는다(src/lib/server/authProxy.js).
# VERCEL=

# --- 결제 (토스페이먼츠) ---

# 토스페이먼츠 클라이언트 키. 테스트 키는 test_ck_로 시작한다. 발급은 docs/ENV.md "토스페이먼츠".
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_toss_client_key
# true면 결제 페이지에 토스 결제창 없이 결제를 끝내는 개발용 버튼을 보인다.
# 백엔드의 ALLOW_PAYMENT_BYPASS와 짝이라 함께 바꾼다. 켜도 되는 곳은 로컬과 E2E뿐이고, 프리뷰·프로덕션에서는 반드시 false다.
# 로컬에서 결제 우회를 쓰려면 직접 true로 바꾼다.
NEXT_PUBLIC_ALLOW_PAYMENT_BYPASS=false
