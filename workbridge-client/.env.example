NEXT_PUBLIC_API_URL=http://localhost:4000
# 서버 쪽 전용(Next 프록시 라우트, SSR). 값이 있으면 NEXT_PUBLIC_API_URL보다 우선한다. 선택.
API_URL=
# 서버 쪽 전용. Vercel 프리뷰에서 {branch}를 VERCEL_GIT_COMMIT_REF의 슬러그로 바꿔 같은 브랜치의 서버 프리뷰를 부른다.
# 예: https://workbridge-server-git-{branch}-jonghoon24s-projects.vercel.app — API_URL이 있으면 무시된다. 로컬에서는 비워 둔다.
API_URL_TEMPLATE=
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_toss_client_key
NEXT_PUBLIC_ALLOW_PAYMENT_BYPASS=false
