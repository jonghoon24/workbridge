NEXT_PUBLIC_API_URL=http://localhost:4000
# 서버 쪽 전용(Next 프록시 라우트, SSR). 값이 있으면 NEXT_PUBLIC_API_URL보다 우선한다. 선택.
API_URL=
# 서버 쪽 전용. 서버의 PROXY_SHARED_SECRET과 같은 값. Vercel에서만 쓰인다(브라우저 IP 전달). 로컬은 비워 둔다.
PROXY_SHARED_SECRET=
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_toss_client_key
NEXT_PUBLIC_ALLOW_PAYMENT_BYPASS=false
